# Resend credentials for the Vercel newsletter Functions.
# Create this key in Resend with email-sending and contact/segment permissions.
RESEND_API_KEY=

# ID of the Resend segment that receives confirmed newsletter subscribers.
RESEND_SEGMENT_ID=

# Must use a sender address on a domain verified in Resend.
RESEND_FROM_EMAIL="Saviour Ukobong <notes@your-verified-domain.com>"

# Generate a unique value with at least 32 random bytes; never use a shared/example value.
# PowerShell: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
NEWSLETTER_SIGNING_SECRET=

# Optional: defaults to the live Vercel project URL.
NEWSLETTER_API_URL=https://xukobong.vercel.app

# Optional: defaults to the live Vercel site origin. Add custom site origins comma-separated.
NEWSLETTER_ALLOWED_ORIGINS=https://xukobong.vercel.app
